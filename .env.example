# Copy to .env and fill in. Never commit the real .env.
# Used by docker-compose.yml, or as the systemd EnvironmentFile (/etc/price-checker.env).

# --- Docker / public hostname ---
# Public host name used by Docker Compose and Caddy for HTTPS.
DOMAIN=prices.example.com
# Cloudflare Tunnel token; only needed if you add the cloudflared service (see docs/deployment.md).
# TUNNEL_TOKEN=

# --- API providers ---
# Set the key for each provider you want to use.
SERPAPI_API_KEY=
UNWRANGLE_API_KEY=
APIFY_API_TOKEN=
# Provider used by default: auto, serpapi, unwrangle, or apify.
PRICE_CHECKER_API_PROVIDER=serpapi
# Optional provider request timeouts, in seconds.
# SERPAPI_TIMEOUT_SECONDS=90
# UNWRANGLE_TIMEOUT_SECONDS=90
# APIFY_TIMEOUT_SECONDS=180
# Default ZIP code for Lowes lookups when no store ZIP is saved (5 digits).
# APIFY_LOWES_ZIP=

# --- Accounts and request limits ---
# Registration policy: admin (admins create accounts), invite (admins invite), or open (public signup).
PRICE_CHECKER_REGISTRATION=admin
# Per-user daily API-call budget; 0 means unlimited.
PRICE_CHECKER_USER_DAILY_API_CALLS=150
# Server-wide daily API-call budget; 0 means unlimited.
PRICE_CHECKER_GLOBAL_DAILY_API_CALLS=0
# Maximum manual rechecks per user per hour; 0 means unlimited.
PRICE_CHECKER_RECHECKS_PER_HOUR=20
# Maximum tracked products per user (20-100).
PRICE_CHECKER_MAX_URLS=100
# Session inactivity timeout (5-10080 minutes).
# PRICE_CHECKER_SESSION_IDLE_MINUTES=120
# Remember-me cookie lifetime (0-365 days; 0 disables it).
# PRICE_CHECKER_REMEMBER_DAYS=30
# Failed logins allowed before lockout (3-50).
# PRICE_CHECKER_LOGIN_MAX_FAILURES=5
# Login lockout duration (1-1440 minutes).
# PRICE_CHECKER_LOGIN_LOCKOUT_MINUTES=15
# Login attempts per client IP per hour (5-1000).
# PRICE_CHECKER_LOGIN_IP_LIMIT=20
# Whether rate-limit responses include a Retry-After header (true/false).
# PRICE_CHECKER_RETRY_AFTER=true

# --- Scanning and server tuning ---
# UTC hour (0-23) to scan all accounts daily; -1 disables scheduled scans.
PRICE_CHECKER_SCHEDULED_SCAN_HOUR=-1
# Worker threads.
PRICE_CHECKER_THREADS=8
# Price cache lifetime (hours).
# PRICE_CHECKER_CACHE_HOURS=24
# Minimum delay between provider requests (seconds).
# PRICE_CHECKER_MIN_DELAY=4
# Web server: auto, werkzeug, waitress, or gunicorn.
# PRICE_CHECKER_SERVER=auto

# --- Storage and network ---
# Operating mode: local (default), lan, or public.
# Keep commented for Docker Compose, which configures public mode itself.
# For LAN mode, initialize the secret and create an admin with `python main.py init-secret`
# and `python main.py create-admin`. Public mode also needs an allowed host and trusted proxy.
# PRICE_CHECKER_MODE=local
# Port to listen on. PORT is a fallback for hosting platforms; prefer PRICE_CHECKER_PORT.
# PRICE_CHECKER_PORT=5000
# PORT=5000
# Bind address in LAN/public mode; local mode always binds to 127.0.0.1.
# PRICE_CHECKER_HOST=0.0.0.0
# Directory for the database, secret, and generated certificates.
# PRICE_CHECKER_DATA_DIR=/var/lib/price-checker
# Override the main database and developer-response database file paths.
# PRICE_CHECKER_DB=/var/lib/price-checker/price_checker.sqlite3
# PRICE_CHECKER_DEV_DB=/var/lib/price-checker/price_checker.dev.sqlite3
# Persistent session-signing secret for hosted modes; alternatively run `python main.py init-secret`.
# PRICE_CHECKER_SECRET=
# Comma-separated host names or IPs accepted by the app.
# PRICE_CHECKER_ALLOWED_HOSTS=prices.example.com
# Number of trusted reverse-proxy hops (1 when behind one proxy, as with Caddy).
# PRICE_CHECKER_TRUSTED_PROXIES=1

# --- LAN TLS ---
# LAN TLS mode: off, selfsigned, or custom. Selfsigned certificates are generated automatically.
# PRICE_CHECKER_TLS=selfsigned
# Paths to your certificate and private key when PRICE_CHECKER_TLS=custom.
# PRICE_CHECKER_TLS_CERT=/path/to/cert.pem
# PRICE_CHECKER_TLS_KEY=/path/to/key.pem

# --- Local mode and admin setup ---
# Enable developer tools in local mode (true/false).
# PRICE_CHECKER_DEVELOPER_MODE=false
# Open the browser automatically in local mode (true/false).
# PRICE_CHECKER_OPEN_BROWSER=true
# Override the URL scheme used when opening the local app (http or https).
# PRICE_CHECKER_URL_SCHEME=http
# Optional credentials for scripted admin creation or password reset; avoid storing passwords here.
# PRICE_CHECKER_ADMIN_USERNAME=
# PRICE_CHECKER_ADMIN_PASSWORD=

# --- Optional GitHub update-check rate limit ---
# Personal access token used only to raise the GitHub API rate limit for update checks.
# GITHUB_TOKEN=
