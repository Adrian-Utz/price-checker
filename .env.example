# Copy to .env and fill in. Never commit the real .env.
# Used by docker-compose.yml, or as the systemd EnvironmentFile (/etc/price-checker.env).

# --- Docker (docker-compose.yml) ---
# The public host name that points at this server. Caddy gets its HTTPS certificate for it.
DOMAIN=prices.example.com

# --- Paid API keys (set at least the one you use) ---
SERPAPI_API_KEY=
UNWRANGLE_API_KEY=
APIFY_API_TOKEN=
PRICE_CHECKER_API_PROVIDER=serpapi

# --- Accounts ---
# admin = only admins create accounts, invite = admins send invite links, open = anyone may sign up
PRICE_CHECKER_REGISTRATION=admin

# --- Limits (0 = unlimited) ---
PRICE_CHECKER_USER_DAILY_API_CALLS=150
PRICE_CHECKER_GLOBAL_DAILY_API_CALLS=0
PRICE_CHECKER_RECHECKS_PER_HOUR=20
PRICE_CHECKER_MAX_URLS=100

# --- Optional ---
# UTC hour (0-23) to scan every account automatically each day. -1 = off.
PRICE_CHECKER_SCHEDULED_SCAN_HOUR=-1
PRICE_CHECKER_THREADS=8

# ======================================================================
# Mode examples. Keep these commented out when using docker-compose.yml:
# the container already runs in public mode, and an active line here would override it.
# Uncomment ONE block when running without Docker (python main.py, or systemd).
# ======================================================================

# --- local (default): just you, on your own computer. ---
# No accounts, no login. Listens on 127.0.0.1 only, opens your browser, and stops when you close the tab.
# You don't need to set anything; this is what you get with no PRICE_CHECKER_MODE.
# PRICE_CHECKER_MODE=local
# PRICE_CHECKER_PORT=5000
# PRICE_CHECKER_DEVELOPER_MODE=0

# --- lan: your home or office network. ---
# First run: python main.py init-secret, then python main.py create-admin <name>.
# PRICE_CHECKER_MODE=lan
# PRICE_CHECKER_PORT=5000
# off = plain HTTP (passwords are not encrypted), selfsigned = generated certificate (browsers warn once),
# custom = your own certificate files below.
# PRICE_CHECKER_TLS=selfsigned
# PRICE_CHECKER_TLS_CERT=/path/to/cert.pem
# PRICE_CHECKER_TLS_KEY=/path/to/key.pem
# Optional: only answer to these names. Also added to the self-signed certificate.
# PRICE_CHECKER_ALLOWED_HOSTS=pricechecker.lan,192.168.1.50
# PRICE_CHECKER_DATA_DIR=/var/lib/price-checker

# --- public: the internet, behind an HTTPS reverse proxy (Caddy). Docker sets these for you. ---
# For systemd, also set PRICE_CHECKER_SECRET or create it with python main.py init-secret.
# PRICE_CHECKER_MODE=public
# PRICE_CHECKER_DATA_DIR=/var/lib/price-checker
# PRICE_CHECKER_ALLOWED_HOSTS=prices.example.com
# PRICE_CHECKER_TRUSTED_PROXIES=1
