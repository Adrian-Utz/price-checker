[Unit]
Description=Price Checker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pricechecker
Group=pricechecker
WorkingDirectory=/opt/price-checker
EnvironmentFile=/etc/price-checker.env
Environment=PRICE_CHECKER_DATA_DIR=/var/lib/price-checker
ExecStart=/opt/price-checker/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5

# /var/lib/price-checker is created and owned by the service user.
StateDirectory=price-checker
StateDirectoryMode=0700

# Sandboxing
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
ReadWritePaths=/var/lib/price-checker

[Install]
WantedBy=multi-user.target
