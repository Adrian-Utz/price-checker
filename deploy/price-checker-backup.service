[Unit]
Description=Back up the Price Checker database

[Service]
Type=oneshot
User=pricechecker
Group=pricechecker
WorkingDirectory=/opt/price-checker
EnvironmentFile=/etc/price-checker.env
Environment=PRICE_CHECKER_DATA_DIR=/var/lib/price-checker
# Keeps the newest 14 copies in /var/lib/price-checker/backups
ExecStart=/opt/price-checker/.venv/bin/python main.py backup 14
StateDirectory=price-checker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/price-checker
